{
  "name": "comforce-connect",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.15.0" },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/intake.test.mjs",
    "test:db": "supabase test db",
    "test:assistant": "node --env-file-if-exists=.env.local tests/assistant.mjs",
    "test:live":"node --env-file-if-exists=.env.local tests/walkthrough.mjs",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "openai": "7.62.0",
    "@fontsource-variable/dm-sans": "^5.2.0",
    "@supabase/supabase-js": "2.119.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "playwright-core": "1.65.1",
    "supabase": "2.122.1",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  }
}
