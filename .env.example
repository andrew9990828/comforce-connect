# Browser configuration. Codex (GPT-6) documented the two Vite build inputs.
# Use the Supabase publishable key. A local legacy anon key also works.
# Keep database passwords, secret keys and service-role keys out of Vite variables.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Local dev/preview on laptop and phone. On Pages set this to https://YOUR_PROJECT_REF.supabase.co.
VITE_SUPABASE_URL=/api
